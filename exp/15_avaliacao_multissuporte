    "from pathlib import Path\n",
    "import os\n",
    "import sys\n",
    "\n",
    "REPO = Path(\"/workspace/ProtoSAM-repro\")\n",
    "os.chdir(REPO)\n",
    "\n",
    "print(\"Python:\", sys.executable)\n",
    "print(\"Diretório:\", Path.cwd())\n",
    "\n",
    "# Pastas de dados e resultados volumosos não precisam ser percorridas.\n",
    "IGNORAR = {\n",
    "    \".git\", \".ipynb_checkpoints\", \"__pycache__\",\n",
    "    \"data\", \"datasets\", \"node_modules\",\n",
    "    \"mascaras\", \"cache\", \"wandb\",\n",
    "}\n",
    "\n",
    "TERMOS = (\n",
    "    \"distill\", \"destil\", \"resolu\", \"resolution\",\n",
    "    \"support\", \"suporte\", \"dinov2\",\n",
    ")\n",
    "\n",
    "print(\"\\n=== CÓDIGO CANDIDATO ===\")\n",
    "for raiz in (Path(\"/workspace/ProtoSAM\"), REPO):\n",
    "    if not raiz.exists():\n",
    "        continue\n",
    "\n",
    "    encontrados = []\n",
    "    for pasta, dirs, arquivos in os.walk(raiz, followlinks=False):\n",
    "        dirs[:] = [\n",
    "            d for d in dirs\n",
    "            if d not in IGNORAR and d != \"reproducao\"\n",
    "        ]\n",
    "        for nome in arquivos:\n",
    "            p = Path(pasta) / nome\n",
    "            if (\n",
    "                p.suffix in {\".py\", \".ipynb\"}\n",
    "                and any(t in nome.lower() for t in TERMOS)\n",
    "            ):\n",
    "                encontrados.append(p)\n",
    "\n",
    "    print(f\"\\n{raiz}\")\n",
    "    for p in sorted(encontrados):\n",
    "        print(p)\n",
    "\n",
    "print(\"\\n=== CHECKPOINTS COM INDÍCIO DE DESTILAÇÃO ===\")\n",
    "for raiz in (Path(\"/workspace/ProtoSAM\"), REPO):\n",
    "    if not raiz.exists():\n",
    "        continue\n",
    "\n",
    "    encontrados = []\n",
    "    for pasta, dirs, arquivos in os.walk(raiz, followlinks=False):\n",
    "        dirs[:] = [d for d in dirs if d not in IGNORAR]\n",
    "        for nome in arquivos:\n",
    "            p = Path(pasta) / nome\n",
    "            if (\n",
    "                p.suffix in {\".pt\", \".pth\", \".ckpt\"}\n",
    "                and any(t in str(p).lower() for t in (\"distill\", \"destil\"))\n",
    "            ):\n",
    "                encontrados.append(p)\n",
    "\n",
    "    print(f\"\\n{raiz}\")\n",
    "    if not encontrados:\n",
    "        print(\"Nenhum encontrado pelo nome do arquivo ou da pasta.\")\n",
    "    for p in sorted(encontrados):\n",
    "        print(p)\n",
    "\n",
    "print(\"\\nInspeção concluída. Nenhuma avaliação ou treinamento iniciado.\")"
   ]
